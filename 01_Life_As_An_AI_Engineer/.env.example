# Copy this file to `.env` in THIS folder:
#     cp .env.example .env
#
# `.env` is gitignored, so your real key is never committed.
# The notebook loads it automatically via python-dotenv.

# Your OpenAI API key: get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here

# Optional. Override the model, or point at any OpenAI-compatible endpoint
# (a LiteLLM proxy, a local server). Leave commented out for the defaults.
# LLM_MODEL=gpt-5.4-mini
# LLM_API_BASE=http://localhost:4000/v1
